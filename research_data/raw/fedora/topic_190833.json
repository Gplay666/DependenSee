size}/71_2.png", "moderator": true, "trust_level": 3}}, {"extras": null, "description": "Recent Poster", "user": {"id": 3019, "username": "computersavvy", "name": "Jeff V", "avatar_template": "/user_avatar/discussion.fedoraproject.org/computersavvy/{size}/4741_2.png", "flair_name": "ask-fedora", "flair_group_id": 53, "primary_group_name": "ask-fedora", "moderator": true, "trust_level": 4}}]}, {"fancy_title": "Unable to log back into GNOME session on Fedora 42 after login on Xfce session", "id": 150431, "title": "Unable to log back into GNOME session on Fedora 42 after login on Xfce session", "slug": "unable-to-log-back-into-gnome-session-on-fedora-42-after-login-on-xfce-session", "posts_count": 13, "reply_count": 9, "highest_post_number": 13, "image_url": null, "created_at": "2025-04-24T11:19:23.070Z", "last_posted_at": "2025-06-13T15:39:51.366Z", "bumped": true, "bumped_at": "2025-06-13T19:24:05.347Z", "archetype": "regular", "unseen": false, "pinned": false, "unpinned": null, "visible": true, "closed": false, "archived": false, "bookmarked": null, "liked": null, "tags": [{"id": 868, "name": "gnome", "slug": "gnome"}, {"id": 981, "name": "f42", "slug": "f42"}, {"id": 445, "name": "xfce", "slug": "xfce"}], "tags_descriptions": {}, "like_count": 3, "views": 1803, "category_id": 6, "featured_link": null, "op_like_count": 0, "has_accepted_answer": false, "posters": [{"extras": null, "description": "Original Poster", "user": {"id": 4111, "username": "tiholov", "name": "Kalin Tiholov", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/t/51a2da/{size}.png", "trust_level": 1}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 2081, "username": "ilikelinux", "name": "ilikelinux", "avatar_template": "/user_avatar/discussion.fedoraproject.org/ilikelinux/{size}/27169_2.png", "flair_name": "ask-fedora", "flair_group_id": 53, "primary_group_name": "ask-fedora", "trust_level": 2}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 8762, "username": "vekruse", "name": "Villy Kruse", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/v/aad0ee/{size}.png", "trust_level": 3}}, {"extras": null, "description": "Recent Poster", "user": {"id": 24877, "username": "schultzter", "name": "Eric Schultz", "avatar_template": "/user_avatar/discussion.fedoraproject.org/schultzter/{size}/53526_2.png", "trust_level": 1}}, {"extras": "latest", "description": "Most Recent Poster", "user": {"id": 18985, "username": "tqcharm", "name": "Mike B.", "avatar_template": "/user_avatar/discussion.fedoraproject.org/tqcharm/{size}/40015_2.png", "trust_level": 4}}]}], "summarizable": false, "has_cached_summary": false, "has_livestream": null, "valid_reactions": ["heart", "classic_smiley", "bluethumb", "party", "eureka", "totally", "fedora", "eyes"], "accepted_answers": [{"id": 501209, "name": "Bryan Moore", "username": "bryanmoore", "avatar_template": "/user_avatar/discussion.fedoraproject.org/bryanmoore/{size}/1993_2.png", "created_at": "2026-05-08T12:48:24.451Z", "cooked": "<p>Well, this part of the logs seems off:</p>\n<pre><code class=\"lang-plaintext\">nxexec[3118]: pam_unix(nx:session): session opened for user gdm-greeter(uid=60578) by (uid=978)\naudit: op=PAM:session_open ... acct=\"gdm-greeter\" exe=\"/usr/NX/bin/nxexec\"\n</code></pre>\n<p>That output seems to suggest nxexec is opening a PAM session as gdm-greeter and that shouldn’t be happening.</p>\n<p>How about we try stopping and disabling NoMachine temporarily:</p>\n<pre><code class=\"lang-plaintext\">sudo systemctl stop nxserver.service  # or nxd, depending on NX version\nsudo systemctl disable nxserver.service\nsudo systemctl restart gdm\n</code></pre>\n<p>After a reboot, does everything work?</p>", "post_number": 7, "topic_id": 190833, "url": "/t/cannot-log-in-after-updating-to-fedora-44/190833/7"}], "has_accepted_answer": true, "shared_issue_count": 0, "can_create_shared_issue": false, "shared_issue_visible": true, "discourse_zendesk_plugin_zendes