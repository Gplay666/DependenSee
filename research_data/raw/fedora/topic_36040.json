ure.io/fedora-pgm/pgm_communication\">fedora-pgm/pgm_communication repo</a>.</p>", "post_number": 1, "post_type": 1, "posts_count": 1, "updated_at": "2022-01-14T20:54:03.233Z", "reply_count": 0, "reply_to_post_number": null, "quote_count": 0, "incoming_link_count": 13, "reads": 28, "readers_count": 27, "score": 100.6, "yours": false, "topic_id": 36040, "topic_slug": "fridays-fedora-facts-2022-02", "display_username": "Ben Cotton", "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "badges_granted": [], "version": 1, "can_edit": false, "can_delete": false, "can_recover": false, "can_see_hidden_post": false, "can_wiki": false, "link_counts": [{"url": "https://fedoraproject.org/PackageReviewStatus/", "internal": false, "reflection": false, "title": "Cached Package Review Tracker", "clicks": 1}, {"url": "https://fedoraproject.org/wiki/Changes/Ruby_3.1", "internal": false, "reflection": false, "title": "Changes/Ruby 3.1 - Fedora Project Wiki", "clicks": 1}, {"url": "https://fedoraproject.org/wiki/Changes/DefaultToNotoFonts", "internal": false, "reflection": false, "title": "Changes/DefaultToNotoFonts - Fedora Project Wiki", "clicks": 1}, {"url": "https://fedoraproject.org/wiki/Changes/Users_are_admins_by_default_in_Anaconda", "internal": false, "reflection": false, "title": "Changes/Users are admins by default in Anaconda - Fedora Project Wiki", "clicks": 1}, {"url": "https://bugzilla.redhat.com/show_bug.cgi?id=1955416", "internal": false, "reflection": false, "title": "1955416 – Lenovo ThinkPad T490, unable to boot following clean install, stuck at splash screen", "clicks": 1}, {"url": "https://calendar.fedoraproject.org/meeting/9527/", "internal": false, "reflection": false, "title": "Meeting \"FPgM office hours\" - Fedocal", "clicks": 0}, {"url": "https://calendar.fedoraproject.org/meeting/9742/", "internal": false, "reflection": false, "title": "Meeting \"Fedora Social Hour\" - Fedoc