ull, "description": "Original Poster", "user": {"id": 29096, "username": "coredaemon", "name": "Piyush Goyal", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/c/ffd117/{size}.png", "trust_level": 1}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 29521, "username": "flooper", "name": "Mush P", "avatar_template": "/user_avatar/discussion.fedoraproject.org/flooper/{size}/49855_2.png", "trust_level": 2}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 28091, "username": "tragivictoria", "name": "Victoria 🏳️‍⚧️", "avatar_template": "/user_avatar/discussion.fedoraproject.org/tragivictoria/{size}/56102_2.png", "trust_level": 2}}, {"extras": null, "description": "Recent Poster", "user": {"id": 27056, "username": "breakpointx", "name": "breakpointx", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/b/eb7434/{size}.png", "trust_level": 1}}, {"extras": "latest", "description": "Most Recent Poster", "user": {"id": 30228, "username": "osakasix", "name": "Vik", "avatar_template": "/user_avatar/discussion.fedoraproject.org/osakasix/{size}/50204_2.png", "trust_level": 0}}]}, {"fancy_title": "GNOME Night Light Broken on Fedora 41 (Disappears After a Few Seconds)", "id": 138798, "title": "GNOME Night Light Broken on Fedora 41 (Disappears After a Few Seconds)", "slug": "gnome-night-light-broken-on-fedora-41-disappears-after-a-few-seconds", "posts_count": 2, "reply_count": 0, "highest_post_number": 2, "image_url": "https://us1.discourse-cdn.com/fedoraproject/original/3X/3/b/3b9b1bc360bb76d37e9287b0d93e486e5c056fac.png", "created_at": "2024-12-01T07:06:56.637Z", "last_posted_at": "2024-12-01T07:35:45.160Z", "bumped": true, "bumped_at": "2024-12-01T07:35:45.160Z", "archetype": "regular", "unseen": false, "pinned": false, "unpinned": null, "visible": true, "closed": false, "archived": false, "bookmarked": null, "liked": null, "tags": [{"id": 868, "name": "gnome", "slug": "gnome"}, {"id": 910, "name": "workstation", "slug": "workstation"}, {"id": 398, "name": "wayland", "slug": "wayland"}], "tags_descriptions": {}, "like_count": 1, "views": 932, "category_id": 6, "featured_link": null, "op_like_count": 0, "has_accepted_answer": false, "posters": [{"extras": "latest single", "description": "Original Poster, Most Recent Poster", "user": {"id": 4327, "username": "igorjagec", "name": "Igor Jagec", "avatar_template": "/user_avatar/discussion.fedoraproject.org/igorjagec/{size}/6478_2.png", "trust_level": 2}}]}, {"fancy_title": "Night light not working properly", "id": 74616, "title": "Night light not working properly", "slug": "night-light-not-working-properly", "posts_count": 3, "reply_count": 1, "highest_post_number": 3, "image_url": null, "created_at": "2020-05-06T22:30:48.858Z", "last_posted_at": "2021-02-27T08:53:09.263Z", "bumped": true, "bumped_at": "2021-02-27T08:53:09.263Z", "archetype": "regular", "unseen": false, "pinned": false, "unpinned": null, "visible": true, "closed": false, "archived": false, "bookmarked": null, "liked": null, "tags": [{"id": 365, "name": "f32", "slug": "f32"}], "tags_descriptions": {}, "like_count": 4, "views": 2237, "category_id": 6, "featured_link": null, "op_like_count": 1, "has_accepted_answer": false, "posters": [{"extras": null, "description": "Original Poster", "user": {"id": 10730, "username": "gabrielcsillaz", "name": "Gabriel Csillaz", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/g/603e79/{size}.png", "trust_level": 0}}, {"extras": null, "description": "Recent Poster", "user": {"id": 5288, "username": "bliutwo", "name": "Brian Liu", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/b/afea85/{size}.png", "trust_level": 0}}, {"extras": "latest", "description": "Most Recent Poster", "user": {"id": 5509, "username": "rl", "name": "Ryan", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/r/afea85/{size}.png", "trust_level": 1}}]}], "summarizable": false, "has_cached_summary": false, "has_livestream": null, "valid_reactions": ["heart", "classic_smiley", "bluethumb", "party", "eureka", "totally", "fedora", "eyes"], "accepted_answers": [{"id": 98518, "name": "Meky Aljan", "username": "Meky", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/m/afea85/{size}.png", "created_at": "2020-11-11T05:23:47.161Z", "cooked": "<p>Thanks <a class=\"mention\" href=\"/u/computersavvy\">@computersavvy</a> you are right, I always read carefully and try to understand which packages the <code>autoremove</code> will remove but I am still not a pro user.</p>\n<p>I fixed the problem, I use NVIDIA driver and the NVIDIA uses xorg server and it set it as default for Gnome, after I did an <code>autoremove</code> the default server was changed to Wayland so I did:</p>\n<p>1- A <code>reinstall</code> to <code>akmod-nvidia</code> (not sure if it’s necessary).<br>\n2- A <code>reinstall</code> to <code>xorg-x11-drv-nvidia-cuda</code> (also not sure if it’s necessary).<br>\n3- Edit /etc/gdm/custom.conf  by uncommenting  “<strong>WaylandEnable=false</strong>” and adding “<strong>DefaultSession=gnome-xorg.desktop</strong>”.</p>\n<p>now I can do an <code>autoremove</code> without losing the Night Light feature.<br>\n<div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://us1.discourse-cdn.com/fedoraproject/original/3X/2/3/230aebf2956c2940223b6e1dbec2403b296ac336.png\" data-download-href=\"/uploads/short-url/5006SP4SbuxJRgVS8pnDN0KClqC.png?dl=1\" title=\"0be947d7ce9683a277f2c20cc4ac987599780809.png\" rel=\"noopener nofollow ugc\"><img src=\"https://us1.discourse-cdn.com/fedoraproject/original/3X/2/3/230aebf2956c2940223b6e1dbec2403b296ac336.png\" alt=\"0be947d7ce9683a277f2c20cc4ac987599780809.png\" data-base62-sha1=\"5006SP4SbuxJRgVS8pnDN0KClqC\" width=\"662\" height=\"500\" data-dominant-color=\"343636\"><div class=\"meta\">\n<svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">0be947d7ce9683a277f2c20cc4ac987599780809.png</span><span class=\"informations\">706×533 32.6 KB</span><svg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"><use href=\"#discourse-expand\"></use></svg>\n</div></a></div></p>\n<p>Best Regards.</p>", "post_number": 3, "topic_id": 75804, "url": "/t/night-light-stop-working-after-autoremove-any-solution-please/75804/3"}], "has_accepted_answer": true, "shared_issue_count": 0, "can_create_shared_issue": false, "shared_issue_visible": true, "discourse_zendesk_plugin_zendesk_id": null, "discourse_zendesk_plugin_zendesk_url": "https://your-url.zendesk.com/agent/tickets/", "details": {"can_edit": false, "notification_level": 1, "participants": [{"id": 11682, "username": "Meky", "name": "Meky Aljan", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/m/afea85/{size}.png", "post_count": 2, "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_color": null, "flair_bg_color": null, "flair_group_id": null, "trust_level": 1}, {"id": 3019, "username": "computersavvy", "name": "Jeff V", "avatar_template": "/user_avatar/discussion.fedoraproject.org/computersavvy/{size}/4741_2.png", "post_count": 2, "primary_group_name": "ask-fedora", "flair_name": "ask-fedora", "flair_url": null, "flair_color": "", "flair_bg_color": "", "flair_group_id": 53, "moderator": true, "trust_level": 4}], "created_by": {"id": 11682, "username": "Meky", "name": "Meky Aljan", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/m/afea85/{size}.png"}, "last_poster": {"id": 3019, "username": "computersavvy", "name": "Jeff V", "avatar_template": "/user_avatar/discussion.fedoraproject.org/computersavvy/{size}/4741_2.png"}}, "bookmarks": []}