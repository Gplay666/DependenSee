ries, but <code>dnf</code> does. So <code>dnf</code> can pull in whatever dependencies are necessary from them (as long as they are present there).</p>", "post_number": 2, "topic_id": 54512, "url": "/t/basic-question-re-installing-dependences/54512/2"}], "has_accepted_answer": true, "shared_issue_count": 0, "can_create_shared_issue": false, "shared_issue_visible": true, "discourse_zendesk_plugin_zendesk_id": null, "discourse_zendesk_plugin_zendesk_url": "https://your-url.zendesk.com/agent/tickets/", "details": {"can_edit": false, "notification_level": 1, "participants": [{"id": 4241, "username": "uberlinc", "name": "Lincoln T", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/u/afea85/{size}.png", "post_count": 2, "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_color": null, "flair_bg_color": null, "flair_group_id": null, "trust_level": 0}, {"id": 78, "username": "ankursinha", "name": "FranciscoD", "avatar_template": "/user_avatar/discussion.fedoraproject.org/ankursinha/{size}/71_2.png", "post_count": 1, "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_color": null, "flair_bg_color": null, "flair_group_id": null, "moderator": true, "trust_level": 3}], "created_by": {"id": 4241, "username": "uberlinc", "name": "Lincoln T", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/u/afea85/{size}.png"}, "last_poster": {"id": 4241, "username": "uberlinc", "name": "Lincoln T", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/u/afea85/{size}.png"}}, "bookmarks": []}