on.fedoraproject.org/computersavvy/{size}/4741_2.png", "flair_name": "ask-fedora", "flair_group_id": 53, "primary_group_name": "ask-fedora", "moderator": true, "trust_level": 4}}]}, {"fancy_title": "How can I update my system?", "id": 58919, "title": "How can I update my system?", "slug": "how-can-i-update-my-system", "posts_count": 12, "reply_count": 8, "highest_post_number": 12, "image_url": "https://us1.discourse-cdn.com/fedoraproject/original/3X/5/c/5c39a3c69d1ad4c68fa0f98f8afc3149b0a2fb14.png", "created_at": "2020-06-14T18:53:43.414Z", "last_posted_at": "2020-06-21T13:50:55.316Z", "bumped": true, "bumped_at": "2020-06-21T13:50:55.316Z", "archetype": "regular", "unseen": false, "pinned": false, "unpinned": null, "visible": true, "closed": false, "archived": false, "bookmarked": null, "liked": null, "tags": [], "tags_descriptions": {}, "like_count": 5, "views": 1102, "category_id": 6, "featured_link": null, "op_like_count": 1, "has_accepted_answer": false, "posters": [{"extras": null, "description": "Original Poster", "user": {"id": 10952, "username": "trisun11", "name": "Dzianis Hutsko", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/t/51a2da/{size}.png", "trust_level": 1}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 113, "username": "alexpl", "name": "Alexander Ploumistos", "avatar_template": "/user_avatar/discussion.fedoraproject.org/alexpl/{size}/102_2.png", "trust_level": 2}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 9454, "username": "kiko964", "name": "", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/k/afea85/{size}.png", "trust_level": 2}}, {"extras": null, "description": "Recent Poster", "user": {"id": 1338, "username": "simmon", "name": "Great People OS", "avatar_template": "/user_avatar/discussion.fedoraproject.org/simmon/{size}/41951_2.png", "trust_level": 2}}, {"extras": "latest", "description": "Most Recent Poster", "user": {"id": 12806, "username": "sinamobasheri", "name": "Sina Mobasheri", "avatar_template": "/user_avatar/discussion.fedoraproject.org/sinamobasheri/{size}/10728_2.png", "trust_level": 1}}]}], "summarizable": false, "has_cached_summary": false, "has_livestream": null, "valid_reactions": ["heart", "classic_smiley", "bluethumb", "party", "eureka", "totally", "fedora", "eyes"], "accepted_answers": [{"id": 368332, "name": "Gregory Lee Bartholomew", "username": "glb", "avatar_template": "/user_avatar/discussion.fedoraproject.org/glb/{size}/570_2.png", "created_at": "2024-12-20T22:37:43.074Z", "cooked": "<p>OK. Since you have a newer kernel and you are not actively using the older kernel, I’d try manually removing the older kernel. Watch for it to list what “dependent” programs will be removed along with the kernel packages. There <em>shouldn’t</em> be any, but your update transaction seems to indicate otherwise. If there are dependent programs that you want to keep, then cancel the transaction by answering <code>n</code>.</p>\n<p>Try <code>sudo dnf remove kernel-core-6.11.6-300.fc41.x86_64</code>.</p>", "post_number": 7, "topic_id": 140239, "url": "/t/fedora-41-update-failure/140239/7"}], "has_accepted_answer": true, "shared_issue_count": 0, "can_create_shared_issue": false, "shared_issue_visible": true, "discourse_zendesk_plugin_zendesk_id": null, "discourse_zendesk_plugin_zendesk_url": "https://your-url.zendesk.com/agent/tickets/", "details": {"can_edit": false, "notification_level": 1, "participants": [{"id": 24335, "username": "europapa", "name": "Euro Papa", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/e/f5a326/{size}.png", "post_count": 5, "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_color": null, "flair_bg_color": null, "flair_group_id": null, "trust_level": 1}, {"id": 586, "username": "glb", "name": "Gregory Lee Bartholomew", "avatar_template": "/user_avatar/discussion.fedoraproject.org/glb/{size}/570_2.png", "post_count": 4, "primary_group_name": null, "flair_na