oraproject.org/t/frostyx-module-test-macros-module-beakertest-20201212132744/25791", "internal": true, "reflection": false, "title": "frostyx/module-test-macros-module-beakertest-20201212132744", "clicks": 0}, {"url": "https://discussion.fedoraproject.org/t/error-running-sudo-dnf-update/84156/2", "internal": true, "reflection": true, "title": "Error running sudo dnf update", "clicks": 28}], "read": true, "user_title": "Speak Up!", "title_is_group": false, "bookmarked": false, "actions_summary": [{"id": 2, "count": 4}], "moderator": true, "admin": false, "staff": true, "user_id": 109, "hidden": false, "trust_level": 2, "deleted_at": null, "user_deleted": false, "edit_reason": null, "can_view_edit_history": true, "wiki": false, "mentioned_users": [], "post_url": "/t/cant-install-kernel-package/65607/2", "event": null, "reactions": [{"id": "heart", "type": "emoji", "count": 4}], "current_user_reaction": null, "reaction_users_count": 4, "current_user_used_main_reaction": false, "can_accept_answer": false, "can_unaccept_answer": false, "accepted_answer": true, "topic_accepted_answer": true}, {"id": 214119, "name": "Rob Lowe", "username": "rlowe", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/r/51a2da/{size}.png", "created_at": "2023-04-12T01:06:16.097Z", "cooked": "<p>I recently also ran into this issue on Fedora 37 running dnf update --skip-broken:</p>\n<blockquote>\n<p>Error:<br>\nProblem 1: package kernel-modules-extra-6.0.16-300.fc37.x86_64 requires kernel-uname-r = 6.0.16-300.fc37.x86_64, but none of the providers can be installed</p>\n<ul>\n<li>conflicting requests<br>\nProblem 2: package kernel-6.0.16-300.fc37.x86_64 requires kernel-core-uname-r = 6.0.16-300.fc37.x86_64, but none of the providers can be installed</li>\n<li>conflicting requests</li>\n</ul>\n</blockquote>\n<p>I was running the kernel version 6.1.15-200, so removing all the previous (unused) kernel packages (kernel-core, kernel-modules) fixed this issue.</p>", "post_number": 3, "pos