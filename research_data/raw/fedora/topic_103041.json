{"post_stream": {"posts": [{"id": 271526, "name": "Ivan Paul", "username": "ivanskiii", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/i/294172/{size}.png", "created_at": "2024-01-26T14:04:29.872Z", "cooked": "<p>and another question, how to clear all cache or redundant or junk in fedora? what command line most of apps i install with .rpm extension</p>", "post_number": 1, "post_type": 1, "posts_count": 12, "updated_at": "2024-01-26T14:12:47.935Z", "reply_count": 0, "reply_to_post_number": null, "quote_count": 0, "incoming_link_count": 43722, "reads": 220, "readers_count": 219, "score": 218424.0, "yours": false, "topic_id": 103041, "topic_slug": "how-to-clear-all-cache", "display_username": "Ivan Paul", "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "badges_granted": [], "version": 1, "can_edit": false, "can_delete": false, "can_recover": false, "can_see_hidden_post": false, "can_wiki": false, "link_counts": [{"url": "https://discussion.fedoraproject.org/t/how-to-install-uninstall-androio-studio-when-i-download-it-in-official-site/103017/4", "internal": true, "reflection": true, "title": "How to install & uninstall androio studio when i download it in official site", "clicks": 8}, {"url": "https://discussion.fedoraproject.org/t/ensuring-nvidia-gpu-functionality-on-fedora/103453/10", "internal": true, "reflection": true, "title": "Ensuring nvidia GPU functionality on fedora", "clicks": 7}], "read": true, "user_title": null, "bookmarked": false, "actions_summary": [], "moderator": false, "admin": false, "staff": false, "user_id": 18270, "hidden": false, "trust_level": 1, "deleted_at": null, "user_deleted": false, "edit_reason": null, "can_view_edit_history": true, "wiki": false, "mentioned_users": [], "post_url": "/t/how-to-clear-all-cache/103041/1", "event": null, "calendar_details": [], "reactions": [], "current_user_reaction": null, "reaction_users_count": 0, "current_user_used_main_reaction": false, "can_accept_answer": false, "can_unaccept_answer": false, "accepted_answer": false, "topic_accepted_answer": null}, {"id": 271539, "name": "P. K. Mays", "username": "pkmays", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/p/294172/{size}.png", "created_at": "2024-01-26T14:22:20.925Z", "cooked": "<p>Hi, here’s some sauce:</p>\n<p><code>sudo dnf clean all</code></p>\n<p>Also, read the post-upgrade section here if you really have OCD. =^)</p>\n<aside class=\"onebox allowlistedgeneric\" data-onebox-src=\"https://docs.fedoraproject.org/en-US/quick-docs/upgrading-fedora-offline/#sect-resolving-post-upgrade-issues\">\n  <header class=\"source\">\n\n      <a href=\"https://docs.fedoraproject.org/en-US/quick-docs/upgrading-fedora-offline/#sect-resolving-post-upgrade-issues\" target=\"_blank\" rel=\"noopener\">Fedora Docs</a>\n  </header>\n\n  <article class=\"onebox-body\">\n    <div class=\"aspect-image\" style=\"--aspect-ratio:225/62;\"><img src=\"https://us1.discourse-cdn.com/fedoraproject/original/2X/4/4475ce42a869f70b1d515bd1da99681add9ce512.png\" class=\"thumbnail\" data-dominant-color=\"4E7EAE\" width=\"225\" height=\"62\"></div>\n\n<h3><a href=\"https://docs.fedoraproject.org/en-US/quick-docs/upgrading-fedora-offline/#sect-resolving-post-upgrade-issues\" target=\"_blank\" rel=\"noopener\">Upgrading Fedora Using DNF System Plugin</a></h3>\n\n  <p>dnf-plugin-system-upgrade is a plugin for the DNF package manager and is used to upgrade your system to the current release of Fedora. For Fedora Silverblue and Fedora CoreOS, which use…</p>\n\n\n  </article>\n\n  <div class=\"onebox-metadata\">\n    \n    \n  </div>\n\n  <div style=\"clear: both\"></div>\n</aside>\n", "post_number": 3, "post_type": 1, "posts_count": 12, "updated_at": "2024-01-26T14:22:20.925Z", "reply_count": 1, "reply_to_post_number": null, "quote_count": 0, "incoming_link_count": 237, "reads": 215, "readers_count": 214, "score": 1248.0, "yours": fals