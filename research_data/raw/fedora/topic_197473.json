", "name": "P G", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/p/aad0ee/{size}.png", "trust_level": 3}}, {"extras": "latest", "description": "Most Recent Poster", "user": {"id": 34259, "username": "william-yang", "name": "William Yang", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/w/38bc3b/{size}.png", "trust_level": 0}}]}, {"fancy_title": "Upgraded to kernel 6.14-3, black screen on boot", "id": 150396, "title": "Upgraded to kernel 6.14-3, black screen on boot", "slug": "upgraded-to-kernel-6-14-3-black-screen-on-boot", "posts_count": 20, "reply_count": 11, "highest_post_number": 21, "image_url": null, "created_at": "2025-04-24T06:43:23.422Z", "last_posted_at": "2025-05-28T14:12:15.324Z", "bumped": true, "bumped_at": "2025-05-28T19:39:36.658Z", "archetype": "regular", "unseen": false, "pinned": false, "unpinned": null, "visible": true, "closed": false, "archived": false, "bookmarked": null, "liked": null, "tags": [{"id": 395, "name": "kde", "slug": "kde"}, {"id": 981, "name": "f42", "slug": "f42"}], "tags_descriptions": {}, "like_count": 4, "views": 1446, "category_id": 6, "featured_link": null, "op_like_count": 0, "has_accepted_answer": false, "posters": [{"extras": null, "description": "Original Poster", "user": {"id": 26575, "username": "ayhan", "name": "ayhan", "avatar_template": "/user_avatar/discussion.fedoraproject.org/ayhan/{size}/45344_2.png", "trust_level": 1}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 27049, "username": "dylhack", "name": "Dylan Hackworth", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/d/51a2da/{size}.png", "trust_level": 0}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 26380, "username": "lroint", "name": "# LRoInT", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/l/ffd117/{size}.png", "trust_level": 1}}, {"extras": null, "description": "Recent Poster", "user": {"id": 26953, "username": "ultimathulee", "name": "ultimathulee", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/u/ffd117/{size}.png", "trust_level": 1}}, {"extras": "latest", "description": "Most Recent Poster", "user": {"id": 26689, "username": "helgi", "name": "Oleg Sliusar", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/h/eb7434/{size}.png", "trust_level": 1}}]}], "summarizable": false, "has_cached_summary": false, "has_livestream": null, "valid_reactions": ["heart", "classic_smiley", "bluethumb", "party", "eureka", "totally", "fedora", "eyes"], "accepted_answers": [{"id": 518976, "name": "Natha TERR", "username": "njxt72", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/n/3c6eb4/{size}.png", "created_at": "2026-07-23T12:50:37.533Z", "cooked": "<p>Nevermind, I found the problem.<br>\nThere was no log for the latest Nvidia driver and the latest kernel in <code>/var/cache/akmods/nvidia/</code><br>\nSo, I tried to recompile (?) it with sudo akmods --force but akmods was not available anymore (can’t figure out why though)!<br>\nSo did a <code>sudo dnf install akmod-nvidia</code><br>\nThen  <code>sudo akmods --force</code><br>\nAnd after rebooting, everything was ok.<br>\nLesson learned.<br>\nThanks for leading me on the right path and learning the existence of <code>/var/cache/akmods/nvidia/</code></p>", "post_number": 6, "topic_id": 197473, "url": "/t/latest-update-kernel-7-1-4-nvidia-4070-black-screen/197473/6"}], "has_accepted_answer": true, "shared_issue_count": 0, "can_create_shared_issue": false, "shared_issue_visible": true, "discourse_zendesk_plugin_zendesk_id": null, "discourse_zendesk_plugin_zendesk_url": "https://your-url.zendesk.com/agent/tickets/", "details": {"can_edit": false, "notification_level": 1, "participants": [{"id": 34675, "username": "njxt72", "name": "Natha TERR", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/n/3c6eb4/{size}.png", "post_count": 4, "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_color": null