, "op_like_count": 0, "has_accepted_answer": true, "posters": [{"extras": "latest single", "description": "Original Poster, Most Recent Poster, Accepted Answer", "user": {"id": 18901, "username": "dan1410", "name": "Peter K", "avatar_template": "/user_avatar/discussion.fedoraproject.org/dan1410/{size}/47970_2.png", "trust_level": 1}}]}], "summarizable": false, "has_cached_summary": true, "has_livestream": null, "valid_reactions": ["heart", "classic_smiley", "bluethumb", "party", "eureka", "totally", "fedora", "eyes"], "accepted_answers": [{"id": 508812, "name": "Francis Montagnac", "username": "francismontagnac", "avatar_template": "/user_avatar/discussion.fedoraproject.org/francismontagnac/{size}/51683_2.png", "created_at": "2026-06-07T06:05:03.071Z", "cooked": "<aside class=\"quote no-group\" data-username=\"isaac0clarke\" data-display-name=\"Isaac Clarke\" data-post=\"1\" data-topic=\"193230\">\n<div class=\"title\">\n<div class=\"quote-controls\"></div>\n<img alt=\"\" width=\"24\" height=\"24\" src=\"https://sea1.discourse-cdn.com/fedoraproject/user_avatar/discussion.fedoraproject.org/isaac0clarke/48/48182_2.png\" class=\"avatar\"> Isaac Clarke:</div>\n<blockquote>\n<p>Where can I, and anyone else, read (or watch, inform ourselves) more about this from <strong>recent</strong> sources?</p>\n</blockquote>\n</aside>\n<p><code>dnf info</code> or <code>dnf changelog</code> may help. In this case:</p>\n<pre><code class=\"lang-plaintext\">dnf info steam-arch-transition\n[...]\nDescription    : This package is used to migrate Steam installations from the\n               : legacy i686 package layout to the x86_64 package layout.\n               : \n               : It exists only to handle package replacement and dependency\n               : changes during upgrades, and can be safely removed once the\n               : transition is complete.\n</code></pre>", "post_number": 6, "topic_id": 193230, "url": "/t/clarification-about-the-latest-steam-update-for-fedora-44-around-