l}, {"id": 73932, "name": "FranciscoD", "username": "ankursinha", "avatar_template": "/user_avatar/discussion.fedoraproject.org/ankursinha/{size}/71_2.png", "created_at": "2022-11-04T16:33:09.194Z", "cooked": "<p>Orphaned packages are handed over the <code>orphan</code> user:</p>\n<aside class=\"onebox allowlistedgeneric\" data-onebox-src=\"https://docs.fedoraproject.org/en-US/package-maintainers/Package_Orphaning_Process/#orphaning_procedure\">\n  <header class=\"source\">\n\n      <a href=\"https://docs.fedoraproject.org/en-US/package-maintainers/Package_Orphaning_Process/#orphaning_procedure\" target=\"_blank\" rel=\"noopener\">Fedora Docs</a>\n  </header>\n\n  <article class=\"onebox-body\">\n    <div class=\"aspect-image\" style=\"--aspect-ratio:225/62;\"><img src=\"https://us1.discourse-cdn.com/fedoraproject/original/2X/4/4475ce42a869f70b1d515bd1da99681add9ce512.png\" class=\"thumbnail\" width=\"225\" height=\"62\"></div>\n\n<h3><a href=\"https://docs.fedoraproject.org/en-US/package-maintainers/Package_Orphaning_Process/#orphaning_procedure\" target=\"_blank\" rel=\"noopener\">Package Orphaning Process</a></h3>\n\n  <p>Learn more about Fedora Linux, the Fedora Project &amp; the Fedora Community.</p>\n\n\n  </article>\n\n  <div class=\"onebox-metadata\">\n    \n    \n  </div>\n\n  <div style=\"clear: both\"></div>\n</aside>\n\n<p><a href=\"https://src.fedoraproject.org/user/orphan\" class=\"onebox\" target=\"_blank\" rel=\"noopener\">https://src.fedoraproject.org/user/orphan</a></p>", "post_number": 2, "post_type": 1, "posts_count": 8, "updated_at": "2022-11-04T16:33:09.194Z", "reply_count": 0, "reply_to_post_number": null, "quote_count": 0, "incoming_link_count": 17, "reads": 61, "readers_count": 60, "score": 142.2, "yours": false, "topic_id": 43780, "topic_slug": "how-to-find-orphaned-packages", "display_username": "FranciscoD", "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "badges_granted": [], "version": 1, "can_edit": false, "can_delete": false, "can_recover": false, "can_see_hidden_post": false, "can_wiki": false, "link_counts": [{"url": "https://src.fedoraproject.org/user/orphan", "internal": false, "reflection": false, "clicks": 113}, {"url": "https://docs.fedoraproject.org/en-US/package-maintainers/Package_Orphaning_Process/#orphaning_procedure", "internal": false, "reflection": false, "clicks": 47}], "read": true, "user_title": "", "bookmarked": false, "actions_summary": [{"id": 2, "count": 3}], "moderator": true, "admin": false, "staff": true, "user_id": 78, "hidden": false, "trust_level": 3, "deleted_at": null, "user_deleted": false, "edit_reason": null, "can_view_edit_history": true, "wiki": false, "mentioned_users": [], "post_url": "/t/how-to-find-orphaned-packages/43780/2", "event": null, "reactions": [{"id": "heart", "type": "emoji", "count": 3}], "current_user_reaction": null, "reaction_users_count": 3, "current_user_used_main_reaction": false, "can_accept_answer": false, "can_unaccept_answer": false, "accepted_answer": false, "topic_accepted_answer": null}, {"id": 73934, "name": "Yann Collette", "username": "ycollet", "avatar_template": "/user_avatar/discussion.fedoraproject.org/ycollet/{size}/49451_2.png", "created_at": "2022-11-04T16:54:01.058Z", "cooked": "<p>OK, thanks, I didn’t notice the part related to the orphan user.<br>\nCurrently logged and trying to get the list of package owned by orphan <img src=\"https://emoji.discourse-cdn.com/twitter/slight_smile.png?v=12\" title=\":slight_smile:\" class=\"emoji\" alt=\":slight_smile:\" loading=\"lazy\" width=\"20\" height=\"20\"></p>", "post_number": 3, "post_type": 1, "posts_count": 8, "updated_at": "2022-11-04T16:54:01.058Z", "reply_count": 0, "reply_to_post_number": null, "quote_count": 0, "incoming_link_count": 7, "reads": 60, "readers_count": 59, "score": 62.0, "yours": false, "topic_id": 43780, "topic_slug": "how-to-find-orphaned-packages", "display_username"