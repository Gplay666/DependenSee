ir_name": null, "flair_url": null, "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "badges_granted": [], "version": 1, "can_edit": false, "can_delete": false, "can_recover": false, "can_see_hidden_post": false, "can_wiki": false, "link_counts": [{"url": "https://src.fedoraproject.org/user/orphan", "internal": false, "reflection": false, "clicks": 17}], "read": true, "user_title": "Packaging Team", "title_is_group": false, "bookmarked": false, "actions_summary": [{"id": 2, "count": 2}], "moderator": false, "admin": false, "staff": false, "user_id": 2108, "hidden": false, "trust_level": 2, "deleted_at": null, "user_deleted": false, "edit_reason": null, "can_view_edit_history": true, "wiki": false, "mentioned_users": [], "post_url": "/t/how-to-find-orphaned-packages/43780/4", "event": null, "reactions": [{"id": "heart", "type": "emoji", "count": 2}, {"id": "totally", "type": "emoji", "count": 1}], "current_user_reaction": null, "reaction_users_count": 3, "current_user_used_main_reaction": false, "can_accept_answer": false, "can_unaccept_answer": false, "accepted_answer": false, "topic_accepted_answer": null}, {"id": 73957, "name": "Penguinpee", "username": "gui1ty", "avatar_template": "/user_avatar/discussion.fedoraproject.org/gui1ty/{size}/5888_2.png", "created_at": "2022-11-04T23:54:24.316Z", "cooked": "<p>I think that’s better queried through the API. There’s a script in <a href=\"https://pagure.io/fedora-misc-package-utilities\" class=\"inline-onebox\">Overview - fedora-misc-package-utilities - Pagure.io</a> that might do the trick.</p>", "post_number": 5, "post_type": 1, "posts_count": 8, "updated_at": "2022-11-04T23:54:24.316Z", "reply_count": 0, "reply_to_post_number": 4, "quote_count": 0, "incoming_link_count": 4, "reads": 50, "readers_count": 49, "score": 60.0, "yours": false, "topic_id": 43780, "topic_slug": "how-to-find-orphaned-packages", "display_username": "Penguinpee", "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "badges_granted": [], "version": 1, "can_edit": false, "can_delete": false, "can_recover": false, "can_see_hidden_post": false, "can_wiki": false, "link_counts": [{"url": "https://pagure.io/fedora-misc-package-utilities", "internal": false, "reflection": false, "title": "Overview - fedora-misc-package-utilities - Pagure.io", "clicks": 49}], "read": true, "user_title": "", "reply_to_user": {"id": 2108, "username": "ycollet", "name": "Yann Collette", "avatar_template": "/user_avatar/discussion.fedoraproject.org/ycollet/{size}/49451_2.png"}, "bookmarked": false, "actions_summary": [{"id": 2, "count": 2}], "moderator": false, "admin": false, "staff": false, "user_id": 3829, "hidden": false, "trust_level": 2, "deleted_at": null, "user_deleted": false, "edit_reason": null, "can_view_edit_history": true, "wiki": false, "mentioned_users": [], "post_url": "/t/how-to-find-orphaned-packages/43780/5", "event": null, "reactions": [{"id": "heart", "type": "emoji", "count": 2}], "current_user_reaction": null, "reaction_users_count": 2, "current_user_used_main_reaction": false, "can_accept_answer": false, "can_unaccept_answer": false, "accepted_answer": false, "topic_accepted_answer": null}, {"id": 73978, "name": "Yann Collette", "username": "ycollet", "avatar_template": "/user_avatar/discussion.fedoraproject.org/ycollet/{size}/49451_2.png", "created_at": "2022-11-05T09:44:42.114Z", "cooked": "<p>Thanks, the script worked !<br>\nOn small remark: “python37” was hardcoded in the shebang. The script worked fine with python3 on Fedora 36.</p>", "post_number": 6, "post_type": 1, "posts_count": 8, "updated_at": "2022-11-05T09:44:42.114Z", "reply_count": 1, "reply_to_post_number": null, "quote_count": 0, "incoming_link_count": 2, "reads": 44, "readers_count": 43, "score": 38.8, "yours": false, "topic_id": 43780, "topic_slug": "how-to-find-orphaned-packages", "display_username": "Yann Collette", "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "badges_granted": [], "version": 1, "can_edit": false, "can_delete": false, "can_recover": false, "can_see_hidden_post": false, "can_wiki": false, "read": true, "user_title": "Packaging Team", "title_is_group": false, "bookmarked": false, "actions_summary": [{"id": 2, "count": 1}], "moderator": false, "admin": false, "staff": false, "user_id": 2108, "hidden": false, "trust_level": 2, "deleted_at": null, "user_deleted": false, "edit_reason": null, "can_view_edit_history": true, "wiki": false, "mentioned_users": [], "post_url": "/t/how-to-find-orphaned-packages/43780/6", "event": null, "reactions": [{"id": "heart", "type": "emoji", "count": 1}], "current_user_reaction": null, "reaction_users_count": 1, "current_user_used_main_reaction": false, "can_accept_answer": false, "can_unaccept_answer": false, "accepted_answer": false, "topic_accepted_answer": null}, {"id": 73982, "name": "Penguinpee", "username": "gui1ty", "avatar_template": "/user_avatar/discussion.fedoraproject.org/gui1ty/{size}/5888_2.png", "created_at": "2022-11-05T10:59:59.135Z", "cooked": "<p>That might be a relic from the past. Feel free to submit a PR, but don’t count on getting a quick response. The repo is more like: <em>here are some handy scripts - help yourself - bend it to your own needs</em> it seems.</p>", "post_number": 7, "post_type": 1, "posts_count": 8, "updated_at": "2022-11-05T10:59:59.135Z", "reply_count": 0, "reply_to_post_number": 6, "quote_count": 0, "incoming_link_count": 2, "reads": 44, "readers_count": 43, "score": 63.8, "yours": false, "topic_id": 43780, "topic_slug": "how-to-find-orphaned-packages", "display_username": "Penguinpee", "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "badges_granted": [], "version": 1, "can_edit": false, "can_delete": false, "can_recover": false, "can_se