pre><code class=\"lang-plaintext\">dnf repoquery --whatrequires firefox\n</code></pre>\n<p>to list packages that require firefox, i.e. will install it along if I install them</p>", "post_number": 3, "post_type": 1, "posts_count": 5, "updated_at": "2025-03-01T12:47:24.732Z", "reply_count": 1, "reply_to_post_number": null, "quote_count": 0, "incoming_link_count": 74, "reads": 133, "readers_count": 132, "score": 416.6, "yours": false, "topic_id": 130058, "topic_slug": "how-do-i-find-what-packages-depend-on-a-given-package-as-a-tree", "display_username": "boredsquirrel", "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "badges_granted": [], "version": 1, "can_edit": false, "can_delete": false, "can_recover": false, "can_see_hidden_post": false, "can_wiki": false, "read": true, "user_title": "", "bookmarked": false, "actions_summary": [{"id": 2, "count": 1}], "moderator": false, "admin": false, "staff": false, "user_id": 4387, "hidden": false, "trust_level": 4, "deleted_at": null, "user_deleted": false, "edit_reason": null, "can_view_edit_history": true, "wiki": false, "mentioned_users": [], "post_url": "/t/how-do-i-find-what-packages-depend-on-a-given-package-as-a-tree/130058/3", "event": null, "reactions": [{"id": "heart", "type": "emoji", "count": 1}], "current_user_reaction": null, "reaction_users_count": 1, "current_user_used_main_reaction": false, "can_accept_answer": false, "can_unaccept_answer": false, "accepted_answer": false, "topic_accepted_answer": true}, {"id": 385508, "name": "Joe Walker", "username": "grumpey", "avatar_template": "/user_avatar/discussion.fedoraproject.org/grumpey/{size}/54040_2.png", "created_at": "2025-03-01T13:32:34.224Z", "cooked": "<aside class=\"quote\" data-post=\"7\" data-topic=\"144758\">\n  <div class=\"title\">\n    <div class=\"quote-controls\"></div>\n    <img alt=\"\" width=\"24\" height=\"24\" src=\"https://sea1.discourse-cdn.com/fedoraproject/user_avatar/discussion.fedoraproject.org/vgaetera/48/2552_2.png\" class=\"avatar\">\n    <a href=\"https://discussion.fedoraproject.org/t/how-to-find-out-what-installed-a-certain-weak-dependency/144758/7\">How to find out what installed a certain weak dependency?</a> <a class=\"badge-category__wrapper \" href=\"/c/ask/6\"><span data-category-id=\"6\" style=\"--category-badge-color: #38BC3B; --category-badge-text-color: #FFFFFF;\" data-drop-close=\"true\" class=\"badge-category \" title=\"Have questions? Get answers here! Ask anything about installing, using, troubleshooting, customizing, or upgrading any variant of Fedora Linux.\"><span class=\"badge-category__name\">Ask Fedora</span></span></a>\n  </div>\n  <blockquote>\n    pkg_deps() {\n    for DEP in conflicts depends enhances obsoletes provides \\\n        recommends requires requires_pre suggests supplements\n    do echo \"${DEP}\": $(dnf -q rq --providers-of=\"${DEP}\" \"${@}\")\n    done\n}\npkg_deps libreoffice-gtk4\n  </blockquote>\n</aside>\n", "post_number": 4, "post_type": 1, "posts_count": 5, "updated_at": "2025-03-01T13:32:34.224Z", "reply_count": 0, "reply_to_post_number": 3, "quote_count": 0, "incoming_link_count": 64, "reads": 127, "readers_count": 126, "score": 360.4, "yours": false, "topic_id": 130058, "topic_slug": "how-do-i-find-what-packages-depend-on-a-given-package-as-a-tree", "display_username": "Joe Walker", "primary_group_name": "ask-fedora", "flair_name": null, "flair_url": null, "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "badges_granted": [], "version": 1, "can_edit": false, "can_delete": false, "can_recover": false, "can_see_hidden_post": false, "can_wiki": false, "link_counts": [{"url": "https://discussion.fedoraproject.org/t/how-to-find-out-what-installed-a-certain-weak-dependency/144758/7", "internal": true, "reflection": false, "title": "How to find out what installed a certain weak dependency?", "clicks": 0}], "read": true, "user_title": "Curious Peng