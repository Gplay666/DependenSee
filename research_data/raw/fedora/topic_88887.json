{"post_stream": {"posts": [{"id": 240643, "name": "Warlock Jenkins", "username": "warlock", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/w/b193c8/{size}.png", "created_at": "2023-09-03T09:37:35.213Z", "cooked": "<p>How can I prevent them from loading at startup?<br>\nWill it break the system?<br>\nCan someone provide a full list of related services, I guess masking should be enough</p>", "post_number": 1, "post_type": 1, "posts_count": 4, "updated_at": "2023-09-03T09:37:35.213Z", "reply_count": 1, "reply_to_post_number": null, "quote_count": 0, "incoming_link_count": 2005, "reads": 22, "readers_count": 21, "score": 10029.4, "yours": false, "topic_id": 88887, "topic_slug": "disable-libvirt-and-qemu-related-services", "display_username": "Warlock Jenkins", "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "badges_granted": [], "version": 1, "can_edit": false, "can_delete": false, "can_recover": false, "can_see_hidden_post": false, "can_wiki": false, "read": true, "user_title": null, "bookmarked": false, "actions_summary": [], "moderator": false, "admin": false, "staff": false, "user_id": 4273, "hidden": false, "trust_level": 2, "deleted_at": null, "user_deleted": false, "edit_reason": null, "can_view_edit_history": true, "wiki": false, "mentioned_users": [], "post_url": "/t/disable-libvirt-and-qemu-related-services/88887/1", "event": null, "calendar_details": [], "reactions": [], "current_user_reaction": null, "reaction_users_count": 0, "current_user_used_main_reaction": false, "can_accept_answer": false, "can_unaccept_answer": false, "accepted_answer": false, "topic_accepted_answer": true}, {"id": 240655, "name": "Vladislav Grigoryev", "username": "vgaetera", "avatar_template": "/user_avatar/discussion.fedoraproject.org/vgaetera/{size}/2552_2.png", "created_at": "2023-09-03T10:40:37.650Z", "cooked": "<p>Disable or mask those services:<br>\n<a href=\"https://src.fedoraproject.org/rpms/fedora-release/blob/rawhide/f/90-default.preset#_67-84\" class=\"inline-onebox\">Tree - rpms/fedora-release - src.fedoraproject.org</a></p>\n<p>As an alternative, you can simply remove the related packages and their unused dependencies:</p>\n<pre><code class=\"lang-bash\">sudo dnf remove libvirt\\* qemu\\*\n</code></pre>\n<p>This way you can reclaim about 400 MB of space and speed up future updates on average.</p>", "post_number": 2, "post_type": 1, "posts_count": 4, "updated_at": "2023-09-03T10:56:24.853Z", "reply_count": 1, "reply_to_post_number": 1, "quote_count": 0, "incoming_link_count": 59, "reads": 21, "readers_count": 20, "score": 319.2, "yours": false, "topic_id": 88887, "topic_slug": "disable-libvirt-and-qemu-related-services", "display_username": "Vladislav Grigoryev", "primary_group_name": "ask-fedora", "flair_name": "ask-fedora", "flair_url": null, "flair_bg_color": "", "flair_color": "", "flair_group_id": 53, "badges_granted": [], "version": 3, "can_edit": false, "can_delete": false, "can_recover": false, "can_see_hidden_post": false, "can_wiki": false, "link_counts": [{"url": "https://src.fedoraproject.org/rpms/fedora-release/blob/rawhide/f/90-default.preset#_67-84", "internal": false, "reflection": false, "title": "Tree - rpms/fedora-release - src.fedoraproject.org", "clicks": 48}], "read": true, "user_title": "", "reply_to_user": {"id": 4273, "username": "warlock", "name": "Warlock Jenkins", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/w/b193c8/{size}.png"}, "bookmarked": false, "actions_summary": [{"id": 2, "count": 1}], "moderator": false, "admin": false, "staff": false, "user_id": 549, "hidden": false, "trust_level": 3, "deleted_at": null, "user_deleted": false, "edit_reason": null, "can_view_edit_history": true, "wiki": false, "mentioned_users": [], "post_url": "/t/disable-libvirt-and-qemu-related-services/88887/2", "event": null, "reactions": [{"id": "bluethumb", "type": "emoji", "count": 1}, {"id": "hear