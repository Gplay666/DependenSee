}/45562_2.png", "primary_group_name": "packager", "trust_level": 2}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 8762, "username": "vekruse", "name": "Villy Kruse", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/v/aad0ee/{size}.png", "trust_level": 3}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 3019, "username": "computersavvy", "name": "Jeff V", "avatar_template": "/user_avatar/discussion.fedoraproject.org/computersavvy/{size}/4741_2.png", "flair_name": "ask-fedora", "flair_group_id": 53, "primary_group_name": "ask-fedora", "moderator": true, "trust_level": 4}}, {"extras": null, "description": "Recent Poster", "user": {"id": 586, "username": "glb", "name": "Gregory Lee Bartholomew", "avatar_template": "/user_avatar/discussion.fedoraproject.org/glb/{size}/570_2.png", "trust_level": 4}}]}], "summarizable": false, "has_cached_summary": false, "has_livestream": null, "valid_reactions": ["heart", "classic_smiley", "bluethumb", "party", "eureka", "totally", "fedora", "eyes"], "accepted_answers": [{"id": 449825, "name": "P G", "username": "pg-tips", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/p/aad0ee/{size}.png", "created_at": "2025-10-29T17:57:12.083Z", "cooked": "<p>Actually, looking further, it seems this package has been <a href=\"https://bugzilla.redhat.com/show_bug.cgi?id=2385436#c13\">intentionally retired</a>.</p>\n<p>The maintainers point out that it is <a href=\"https://github.com/untitaker/python-atomicwrites\">deprecated upstream</a>.</p>\n<aside class=\"quote no-group\" data-username=\"gregscott\" data-post=\"1\" data-topic=\"170663\">\n<div class=\"title\">\n<div class=\"quote-controls\"></div>\n<img alt=\"\" width=\"24\" height=\"24\" src=\"https://avatars.discourse-cdn.com/v4/letter/g/b193c8/48.png\" class=\"avatar\"> Greg Scott:</div>\n<blockquote>\n<p>This system and others like it are Wordress web servers, so I’m afraid to mess with Python and its dependencies.</p>\n</blockquote>\n</aside>\n<p>So if you want to play it conservatively (makes sense on a web server of course), then you’re unable to upgrade to Fedora 43 until the packages you use remove their dependency on <code>python3-atomicwrites</code>.</p>\n<p>If you run this, you can see what those packages are:</p>\n<p><code>dnf repoquery --installed --whatdepends python3-atomicwrites</code></p>", "post_number": 3, "topic_id": 170663, "url": "/t/fedora-42-43-upgrade-fails-with-python3-3-13-9-1-fc42-x86-64-does-not-belong-to-a-distupgrade-repository/170663/3"}], "has_accepted_answer": true, "shared_issue_count": 0, "can_create_shared_issue": false, "shared_issue_visible": true, "discourse_zendesk_plugin_zendesk_id": null, "discourse_zendesk_plugin_zendesk_url": "https://your-url.zendesk.com/agent/tickets/", "details": {"can_edit": false, "notification_level": 1, "participants": [{"id": 30031, "username": "gregscott", "name": "Greg Scott", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/g/b193c8/{size}.png", "post_count": 4, "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_color": null, "flair_bg_color": null, "flair_group_id": null, "trust_level": 0}, {"id": 25377, "username": "pg-tips", "name": "P G", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/p/aad0ee/{size}.png", "post_count": 2, "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_color": null, "flair_bg_color": null, "flair_group_id": null, "trust_level": 3}, {"id": 487, "username": "qulogic", "name": "Elliott Sales de Andrade", "avatar_template": "/user_avatar/discussion.fedoraproject.org/qulogic/{size}/458_2.png", "post_count": 2, "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_color": null, "flair_bg_color": null, "flair_group_id": null, "trust_level": 2}], "created_by": {"id": 30031, "username": "gregscott", "name": "Greg Scott", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/g/b193c8/{size}.png"