ivers", "id": 69152, "title": "Remove old flatpak Nvidia drivers", "slug": "remove-old-flatpak-nvidia-drivers", "posts_count": 30, "reply_count": 16, "highest_post_number": 30, "image_url": null, "created_at": "2023-01-25T17:40:36.394Z", "last_posted_at": "2023-01-30T18:53:36.257Z", "bumped": true, "bumped_at": "2023-01-30T18:53:36.257Z", "archetype": "regular", "unseen": false, "pinned": false, "unpinned": null, "visible": true, "closed": false, "archived": false, "bookmarked": null, "liked": null, "tags": [{"id": 886, "name": "nvidia", "slug": "nvidia"}, {"id": 909, "name": "silverblue", "slug": "silverblue"}], "tags_descriptions": {}, "like_count": 1, "views": 7556, "category_id": 6, "featured_link": null, "op_like_count": 0, "has_accepted_answer": true, "posters": [{"extras": null, "description": "Original Poster", "user": {"id": 4238, "username": "jkemp", "name": "James Kemp", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/j/f5a326/{size}.png", "trust_level": 2}}, {"extras": null, "description": "Frequent Poster, Accepted Answer", "user": {"id": 3019, "username": "computersavvy", "name": "Jeff V", "avatar_template": "/user_avatar/discussion.fedoraproject.org/computersavvy/{size}/4741_2.png", "flair_name": "ask-fedora", "flair_group_id": 53, "primary_group_name": "ask-fedora", "moderator": true, "trust_level": 4}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 8570, "username": "kevin-rasco", "name": "Kevin Rasco", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/k/51a2da/{size}.png", "trust_level": 2}}, {"extras": null, "description": "Recent Poster", "user": {"id": 226, "username": "msmafra", "name": "Marcelo Dos Santos Mafra", "avatar_template": "/user_avatar/discussion.fedoraproject.org/msmafra/{size}/55765_2.png", "trust_level": 2}}, {"extras": "latest", "description": "Most Recent Poster", "user": {"id": 8934, "username": "ramimalts", "name": "Rami Maltsev", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/r/afea85/{size}.png", "trust_level": 1}}]}, {"fancy_title": "Heavy flatpak usage of /var", "id": 177961, "title": "Heavy flatpak usage of /var", "slug": "heavy-flatpak-usage-of-var", "posts_count": 17, "reply_count": 11, "highest_post_number": 17, "image_url": null, "created_at": "2025-12-21T20:54:33.721Z", "last_posted_at": "2025-12-23T15:58:23.819Z", "bumped": true, "bumped_at": "2025-12-23T15:58:23.819Z", "archetype": "regular", "unseen": false, "pinned": false, "unpinned": null, "visible": true, "closed": false, "archived": false, "bookmarked": null, "liked": null, "tags": [{"id": 496, "name": "flatpak", "slug": "flatpak"}], "tags_descriptions": {}, "like_count": 5, "views": 850, "category_id": 6, "featured_link": null, "op_like_count": 0, "has_accepted_answer": true, "posters": [{"extras": null, "description": "Original Poster", "user": {"id": 3206, "username": "desperado", "name": "Jochen Röhrig", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/d/3c6eb4/{size}.png", "trust_level": 1}}, {"extras": null, "description": "Recent Poster, Accepted Answer", "user": {"id": 638, "username": "grumpey", "name": "Joe Walker", "avatar_template": "/user_avatar/discussion.fedoraproject.org/grumpey/{size}/54040_2.png", "primary_group_name": "ask-fedora", "trust_level": 4}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 25377, "username": "pg-tips", "name": "P G", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/p/aad0ee/{size}.png", "trust_level": 3}}, {"extras": "latest", "description": "Most Recent Poster", "user": {"id": 3019, "username": "computersavvy", "name": "Jeff V", "avatar_template": "/user_avatar/discussion.fedoraproject.org/computersavvy/{size}/4741_2.png", "flair_name": "ask-fedora", "flair_group_id": 53, "primary_group_name": "ask-fedora", "moderator": true, "trust_level": 4}}]}], "summarizable": false, "has_cached_summary": false, "has_livestream": null, "valid_reactions": ["heart", "classic_smiley", "bluethumb", "party", "eureka", "totally", "fedora", "eyes"], "accepted_answers": [{"id": 203196, "name": "dalto", "username": "dalto", "avatar_template": "/user_avatar/discussion.fedoraproject.org/dalto/{size}/5564_2.png", "created_at": "2021-08-28T14:17:57.127Z", "cooked": "<p>It is the runtime for Fedora flatpaks.  If you don’t have any of the flatpaks that depend on that installed, it will be unused.</p>\n<p>It is more or less always safe to remove flatpaks.</p>\n<aside class=\"quote no-group\" data-username=\"bond\" data-post=\"1\" data-topic=\"77864\">\n<div class=\"title\">\n<div class=\"quote-controls\"></div>\n<img loading=\"lazy\" alt=\"\" width=\"24\" height=\"24\" src=\"https://sea1.discourse-cdn.com/fedoraproject/user_avatar/discussion.fedoraproject.org/bond/48/2164_2.png\" class=\"avatar\"> bond:</div>\n<blockquote>\n<p>After the Branch, there is a label called <strong>Op</strong> . What does this mean? When I remove this package, it said <code>Op= r</code> , and later when I installed the package, it said <code>Op= i</code> . What it’s trying to say?</p>\n</blockquote>\n</aside>\n<p>r for <strong>r</strong>emove and i for <strong>i</strong>nstall.</p>\n<aside class=\"quote no-group\" data-username=\"bond\" data-post=\"1\" data-topic=\"77864\">\n<div class=\"title\">\n<div class=\"quote-controls\"></div>\n<img loading=\"lazy\" alt=\"\" width=\"24\" height=\"24\" src=\"https://sea1.discourse-cdn.com/fedoraproject/user_avatar/discussion.fedoraproject.org/bond/48/2164_2.png\" class=\"avatar\"> bond:</div>\n<blockquote>\n<p>When I tried to reinstall it, it showed a download size of <strong>669 MB</strong> ! It’s a lot.</p>\n</blockquote>\n</aside>\n<p>Flatpak runtimes are typically fairly large. That is normal.</p>", "post_number": 2, "topic_id": 77864, "url": "/t/flatpak-uninstall-unused-command-shows-org-fedoraproject-platform-as-unused-669-mb-package-is-it-okay-to-uninstall-it/77864/2"}], "has_accepted_answer": true, "shared_issue_count": 0, "can_create_shared_issue": false, "shared_issue_visible": true, "discourse_zendesk_plugin_zendesk_id": null, "discourse_zendesk_plugin_zendesk_url": "https://your-url.zendesk.com/agent/tickets/", "details": {"can_edit": false, "notification_level": 1, "participants": [{"id": 2085, "username": "bond", "name": "James bond", "avatar_template": "/user_avatar/discussion.fedoraproject.org/bond/{size}/2164_2.png", "post_count": 2, "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_color": null, "flair_bg_color": null, "flair_group_id": null, "trust_level": 2}, {"id": 3609, "username": "dalto", "name": "dalto", "avatar_template": "/user_avatar/discussion.fedoraproject.org/dalto/{size}/5564_2.png", "post_count": 1, "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_color": null, "flair_bg_color": null, "flair_group_id": null, "trust_level": 4}], "created_by": {"id": 2085, "username": "bond", "name": "James bond", "avatar_template": "/user_avatar/discussion.fedoraproject.org/bond/{size}/2164_2.png"}, "last_poster": {"id": 10058, "username": "Seanny123", "name": "Sean", "avatar_template": "/user_avatar/discussion.fedoraproject.org/seanny123/{size}/9445_2.png"}}, "bookmarks": []}