urs": false, "topic_id": 45038, "topic_slug": "timlau-yumex-ng", "display_username": "Meybo Nõmme", "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "badges_granted": [], "version": 1, "can_edit": false, "can_delete": false, "can_recover": false, "can_see_hidden_post": false, "can_wiki": false, "read": true, "user_title": null, "reply_to_user": {"id": 2774, "username": "timlau", "name": "Tim Lauridsen", "avatar_template": "/user_avatar/discussion.fedoraproject.org/timlau/{size}/3201_2.png"}, "bookmarked": false, "actions_summary": [], "moderator": false, "admin": false, "staff": false, "user_id": 17911, "hidden": false, "trust_level": 1, "deleted_at": null, "user_deleted": false, "edit_reason": null, "can_view_edit_history": true, "wiki": false, "mentioned_users": [], "post_url": "/t/timlau-yumex-ng/45038/14", "event": null, "reactions": [], "current_user_reaction": null, "reaction_users_count": 0, "current_user_used_main_reaction": false, "can_accept_answer": false, "can_unaccept_answer": false, "accepted_answer": false, "topic_accepted_answer": null}, {"id": 369034, "name": "Riyas Valiya", "username": "riyasvaliya", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/r/eb7434/{size}.png", "created_at": "2024-12-23T18:50:16.095Z", "cooked": "<p>Is it possible to install this on RHEL or derivatives? I have Rocky 9 for example.</p>", "post_number": 15, "post_type": 1, "posts_count": 16, "updated_at": "2024-12-23T18:50:16.095Z", "reply_count": 1, "reply_to_post_number": null, "quote_count": 0, "incoming_link_count": 3, "reads": 7, "readers_count": 6, "score": 21.4, "yours": false, "topic_id": 45038, "topic_slug": "timlau-yumex-ng", "display_username": "Riyas Valiya", "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "badges_granted": [], "version": 1, "can_edit": false, "can_delete": false, "can_recover": false, "can_see_hidden_post": false, "can_wiki": false, "read": true, "user_title": null, "bookmarked": false, "actions_summary": [], "moderator": false, "admin": false, "staff": false, "user_id": 24383, "hidden": false, "trust_level": 0, "deleted_at": null, "user_deleted": false, "edit_reason": null, "can_view_edit_history": true, "wiki": false, "mentioned_users": [], "post_url": "/t/timlau-yumex-ng/45038/15", "event": null, "reactions": [], "current_user_reaction": null, "reaction_users_count": 0, "current_user_used_main_reaction": false, "can_accept_answer": false, "can_unaccept_answer": false, "accepted_answer": false, "topic_accepted_answer": null}, {"id": 369037, "name": "Tim Lauridsen", "username": "timlau", "avatar_template": "/user_avatar/discussion.fedoraproject.org/timlau/{size}/3201_2.png", "created_at": "2024-12-23T19:09:56.396Z", "cooked": "<p>I don’t think so, yumex-ng require a lot for newer versions af python, libadwaita, gtk4,  dnf5, etc. there is proberly not available in a long lived distro like RHEL, I only support currently supported version for Fedora.</p>", "post_number": 16, "post_type": 1, "posts_count": 16, "updated_at": "2024-12-23T19:09:56.396Z", "reply_count": 0, "reply_to_post_number": 15, "quote_count": 0, "incoming_link_count": 3, "reads": 7, "readers_count": 6, "score": 16.4, "yours": false, "topic_id": 45038, "topic_slug": "timlau-yumex-ng", "display_username": "Tim Lauridsen", "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "badges_granted": [], "version": 1, "can_edit": false, "can_delete": false, "can_recover": false, "can_see_hidden_post": false, "can_wiki": false, "read": true, "user_title": "Packaging Team", "title_is_group": false, "reply_to_user": {"id": 24383, "username": "riyasvaliya", "name": "Riyas Valiya", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/r/eb7434/{size}.png"}, "bookmarked": false, 