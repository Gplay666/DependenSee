ar/discussion.fedoraproject.org/boredsquirrel/{size}/38156_2.png", "trust_level": 4}}, {"extras": null, "description": "Recent Poster", "user": {"id": 18985, "username": "tqcharm", "name": "Mike B.", "avatar_template": "/user_avatar/discussion.fedoraproject.org/tqcharm/{size}/40015_2.png", "trust_level": 4}}, {"extras": "latest", "description": "Most Recent Poster", "user": {"id": 90, "username": "siosm", "name": "Timothée Ravier", "avatar_template": "/user_avatar/discussion.fedoraproject.org/siosm/{size}/79_2.png", "flair_name": "packager", "flair_group_id": 68, "primary_group_name": "packager", "trust_level": 3}}]}, {"fancy_title": "Fedora 40 Silver Blue upgrade not working", "id": 114387, "title": "Fedora 40 Silver Blue upgrade not working", "slug": "fedora-40-silver-blue-upgrade-not-working", "posts_count": 5, "reply_count": 2, "highest_post_number": 5, "image_url": null, "created_at": "2024-04-25T18:29:02.480Z", "last_posted_at": "2024-04-25T19:51:57.376Z", "bumped": true, "bumped_at": "2024-04-25T19:51:57.376Z", "archetype": "regular", "unseen": false, "pinned": false, "unpinned": null, "visible": true, "closed": false, "archived": false, "bookmarked": null, "liked": null, "tags": [{"id": 947, "name": "f40", "slug": "f40"}], "tags_descriptions": {}, "like_count": 2, "views": 389, "category_id": 6, "featured_link": null, "op_like_count": 0, "has_accepted_answer": false, "posters": [{"extras": "latest", "description": "Original Poster, Most Recent Poster", "user": {"id": 19684, "username": "mari-tarari", "name": "Mari Tarari", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/m/db3279/{size}.png", "trust_level": 1}}, {"extras": null, "description": "Recent Poster", "user": {"id": 12407, "username": "yuntaz", "name": "Sakiko Togawa", "avatar_template": "/user_avatar/discussion.fedoraproject.org/yuntaz/{size}/44300_2.png", "trust_level": 2}}]}], "summarizable": false, "has_cached_summary": false, "has_livestream": null, "valid_reactions": ["heart", "classic_smiley", "bluethumb", "party", "eureka", "totally", "fedora", "eyes"], "accepted_answers": [{"id": 297452, "name": "Sakiko Togawa", "username": "yuntaz", "avatar_template": "/user_avatar/discussion.fedoraproject.org/yuntaz/{size}/44300_2.png", "created_at": "2024-04-29T12:19:28.990Z", "cooked": "<p>On Fedora 40, You can remove all layered and local packages using</p>\n<pre><code class=\"lang-plaintext\">rpm-ostree reset\n</code></pre>\n<p>After this, reinstall all the packages.<br>\nFirst reinstall the <code>rpmfusion-free-release</code> and <code>rpmfusion-nonfree-release</code> and reboot.</p>\n<pre><code class=\"lang-plaintext\">rpm-ostree install https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm\n</code></pre>\n<p>After rebooting, update the system and make the RPM Fusion releases layered, so they won’t cause issues in the future rebase:</p>\n<pre><code class=\"lang-plaintext\">rpm-ostree update --uninstall rpmfusion-free-release --uninstall rpmfusion-nonfree-release --install rpmfusion-free-release --install rpmfusion-nonfree-release\n</code></pre>\n<p>Then, reinstall all previous layered packages with the following command and reboot.</p>\n<pre><code class=\"lang-plaintext\">rpm-ostree install libc.so.6 libdrm.so.2 libGL.so.1 libnsl.so.1 libserialport libwebkit2gtk-4.0.so.37 python3-pip screenfetch steam-devices\n</code></pre>", "post_number": 3, "topic_id": 114779, "url": "/t/cannot-uninstall-the-layered-package-steam-devices-after-upgrading-to-fedora-40/114779/3"}], "has_accepted_answer": true, "shared_issue_count": 0, "can_create_shared_issue": false, "shared_issue_visible": true, "discourse_zendesk_plugin_zendesk_id": null, "discourse_zendesk_plugin_zendesk_url": "https://your-url.zendesk.com/agent/tickets/", "details": {"can_edit": false, "notification_level": 1, "participants": [{"id": 13040, "username": 